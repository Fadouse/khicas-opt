// Same device, clock, angle mode, precision and clean session for both builds.
// Run five times and compare medians; do not infer target speed from a PC.
purge(x);
assert(abs(gaussquad(x^2,x,0,1)-1/3)<1e-8);
assert(abs(gaussquad(exp(-x^2),x,0,1)-0.746824132812427)<1e-8);
[["polynomial",time(integrate(x^15-3*x^7+2,x))],
 ["trigonometric",time(integrate(x^2*sin(x),x))],
 ["rational",time(integrate(1/(x^4+1),x))],
 ["logarithmic",time(integrate(ln(x)^5,x))],
 ["Gaussian symbolic",time(integrate(exp(-x^2),x))],
 ["Gaussian numerical",time(gaussquad(exp(-x^2),x,0,1))],
 ["oscillatory numerical",time(gaussquad(sin(40*x)/(1+x^2),x,0,1))]];
